# Supabase's newer dashboard labels use these names.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional: legacy name for the secret key, used only if SUPABASE_SECRET_KEY is unset.
# SUPABASE_SERVICE_ROLE_KEY=

# Next.js only exposes NEXT_PUBLIC_* values to browser code.
# Set these to the same values as SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
PUBLIC_HOST=thecontrarian.club
ADMIN_HOST=admin.thecontrarian.club

# Optional dev-only overrides for the LAN URL shown in QR codes and share links.
# LOCAL_NETWORK_URL pins the base URL outright; otherwise it is derived from the
# machine's LAN IP plus a port resolved from PORT, then NEXT_PUBLIC_DEV_PORT.
# LOCAL_NETWORK_URL=http://192.168.1.10:3002
# NEXT_PUBLIC_DEV_PORT=3002
# PORT=3002
